{
  "meshConfig": {
    "sources": [
      {
        "name": "Commerce",
        "handler": {
          "graphql": {
            "endpoint": "{env.GRAPHQL_ENDPOINT}",
            "operationHeaders": {
              "Authorization": "{context.headers.Authorization}"
            }
          }
        }
      },
      {
        "name": "LoginModule",
        "handler": {
          "openapi": {
            "source": "./openapi.json",
            "baseUrl": "{env.ACTION_BASE_URL}"
          }
        }
      }
    ],
    "responseConfig": {
      "headers": {
        "Cache-Control": "max-age=120",
        "Vary": "Accept"
      },
      "cache": true,
      "CORS": {
        "maxAge": 60480,
        "methods": [
          "GET",
          "POST",
          "PUT",
          "HEAD",
          "OPTIONS"
        ],
        "origin": [
          "http://localhost",
          "http://localhost:3000",
          "https://feature-otplogin--storefront-otp-project-private--moin-mohd17.aem.page"
        ]
      }
    }
  }
}