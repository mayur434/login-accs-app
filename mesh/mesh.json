{
  "meshConfig": {
    "sources": [
      {
        "name": "Commerce",
        "handler": {
          "graphql": {
            "endpoint": "{env.COMMERCE_GRAPHQL_ENDPOINT}",
            "operationHeaders": {
              "Authorization": "{context.headers.authorization}"
            }
          }
        }
      },
      {
        "name": "LoginModule",
        "handler": {
          "openapi": {
            "source": "./mesh/openapi.json",
            "operationHeaders": {
              "Content-Type": "application/json"
            }
          }
        }
      }
    ]
  }
}