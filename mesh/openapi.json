{
  "openapi": "3.0.3",
  "info": {
    "title": "Login Module API",
    "version": "3.1.0"
  },
  "servers": [
    { "url": "{env.ACTION_BASE_URL}" }
  ],
  "paths": {
    "/generate-otp": {
      "post": {
        "operationId": "generateOtpAction",
        "summary": "Generate OTP for login or auto-register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenerateOtpRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenerateOtpResponse" }
              }
            }
          }
        }
      }
    },
    "/validate-otp": {
      "post": {
        "operationId": "validateOtpAction",
        "summary": "Validate OTP and complete login or registration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ValidateOtpRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ValidateOtpResponse" }
              }
            }
          }
        }
      }
    },
    "/google-sso": {
      "post": {
        "operationId": "googleSsoAction",
        "summary": "Google SSO sign-in (exchange Google ID token for Commerce token)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GoogleSsoRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GoogleSsoResponse" }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "operationId": "getAppConfig",
        "summary": "Get public application configuration (SSO flags, module status)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AppConfigPublic" }
              }
            }
          }
        }
      }
    },
    "/customer": {
      "post": {
        "operationId": "customerAction",
        "summary": "Customer registration (generate OTP) or update details",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CustomerRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CustomerResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GenerateOtpRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "mobile": { "type": "string" },
          "mobile_number": { "type": "string" },
          "firstname": { "type": "string" },
          "firstName": { "type": "string" },
          "lastname": { "type": "string" },
          "lastName": { "type": "string" }
        }
      },
      "GenerateOtpResponse": {
        "type": "object",
        "properties": {
          "otpReferenceId": { "type": "string" },
          "otpValue": { "type": "string" },
          "success": { "type": "boolean" },
          "statusCode": { "type": "integer" },
          "error": { "type": "string" }
        }
      },
      "ValidateOtpRequest": {
        "type": "object",
        "properties": {
          "otpReferenceId": { "type": "string" },
          "otpValue": { "type": "string" }
        }
      },
      "ValidateOtpResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "customer_token": { "type": "string" },
          "message": { "type": "string" },
          "statusCode": { "type": "integer" },
          "error": { "type": "string" },
          "customer": { "$ref": "#/components/schemas/Customer" }
        }
      },
      "CustomerRequest": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "email": { "type": "string" },
          "mobile": { "type": "string" },
          "mobile_number": { "type": "string" },
          "firstname": { "type": "string" },
          "firstName": { "type": "string" },
          "lastname": { "type": "string" },
          "lastName": { "type": "string" },
          "customer_token": { "type": "string" },
          "customer_id": { "type": "string" },
          "new_email": { "type": "string" }
        }
      },
      "CustomerResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "customer_token": { "type": "string" },
          "message": { "type": "string" },
          "otpReferenceId": { "type": "string" },
          "otpValue": { "type": "string" },
          "statusCode": { "type": "integer" },
          "error": { "type": "string" },
          "customer": { "$ref": "#/components/schemas/Customer" }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "customer_id": { "type": "string" },
          "id": { "type": "string" },
          "firstname": { "type": "string" },
          "lastname": { "type": "string" },
          "email": { "type": "string" },
          "mobile_number": { "type": "string" },
          "login_type": { "type": "string" },
          "login_provider": { "type": "string" },
          "status": { "type": "string" }
        }
      },
      "GoogleSsoRequest": {
        "type": "object",
        "required": ["google_token"],
        "properties": {
          "google_token": {
            "type": "string",
            "description": "Google ID token (JWT) from Google Sign-In"
          }
        }
      },
      "GoogleSsoResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "customer_token": { "type": "string" },
          "message": { "type": "string" },
          "statusCode": { "type": "integer" },
          "error": { "type": "string" },
          "customer": { "$ref": "#/components/schemas/Customer" }
        }
      },
      "AppConfigPublic": {
        "type": "object",
        "description": "Public-safe subset of app_config (no secrets)",
        "properties": {
          "is_enabled": { "type": "boolean" },
          "google_sso_enabled": { "type": "boolean" },
          "google_client_id": { "type": "string" }
        }
      }
    }
  }
}