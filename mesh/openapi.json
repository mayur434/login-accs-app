{
  "openapi": "3.0.3",
  "info": {
    "title": "Adobe Commerce Custom Login API",
    "version": "1.0.0",
    "description": "OTP-based customer authentication and customer management actions for Adobe Commerce via Adobe App Builder."
  },
  "servers": [
    {
      "url": "https://localhost:9080/api/v1/web/login-module",
      "description": "Injected from mesh/.env.mesh at deploy time"
    }
  ],
  "paths": {
    "/otp": {
      "post": {
        "operationId": "invokeOtp",
        "summary": "Generate or validate OTP",
        "description": "Generates OTP for mobile/email login and validates OTP for customer authentication.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "loginType": {
                    "type": "string",
                    "enum": [
                      "email",
                      "mobile"
                    ],
                    "description": "Identifier type for the customer."
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Customer email. Required when loginType is email."
                  },
                  "mobile": {
                    "type": "string",
                    "description": "Customer mobile number. Required when loginType is mobile."
                  },
                  "otpReferenceId": {
                    "type": "string",
                    "description": "Reference ID returned during OTP generation. Required for OTP validation."
                  },
                  "otpValue": {
                    "type": "string",
                    "description": "OTP value entered by the customer. Required for OTP validation."
                  },
                  "register": {
                    "type": "boolean",
                    "description": "If true, auto-register customer when customer does not already exist."
                  }
                },
                "required": [
                  "loginType"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP generated or validated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "Indicates whether the operation succeeded."
                    },
                    "message": {
                      "type": "string",
                      "description": "Human-readable status message."
                    },
                    "otpReferenceId": {
                      "type": "string",
                      "description": "Returned when OTP is generated."
                    },
                    "otpValue": {
                      "type": "string",
                      "description": "Returned only when otp_in_response is enabled."
                    },
                    "customer_token": {
                      "type": "string",
                      "description": "Returned when OTP is successfully validated."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid parameters, invalid OTP reference, or expired OTP."
          },
          "401": {
            "description": "Invalid OTP."
          },
          "403": {
            "description": "OTP module is disabled."
          },
          "404": {
            "description": "Customer not found or registration required."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/customer": {
      "post": {
        "operationId": "invokeCustomer",
        "summary": "Execute a customer operation",
        "description": "Handles customer registration and customer profile update operations. The operation field determines which flow is executed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "register",
                      "updateCustomerDetails"
                    ],
                    "description": "The customer operation to perform."
                  },
                  "loginType": {
                    "type": "string",
                    "enum": [
                      "email",
                      "mobile"
                    ],
                    "description": "Identifier type for registration flow."
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Customer email address."
                  },
                  "mobile": {
                    "type": "string",
                    "description": "Customer mobile number."
                  },
                  "firstname": {
                    "type": "string",
                    "description": "Customer first name."
                  },
                  "lastname": {
                    "type": "string",
                    "description": "Customer last name."
                  },
                  "otpReferenceId": {
                    "type": "string",
                    "description": "OTP reference ID from OTP generation step."
                  },
                  "otpValue": {
                    "type": "string",
                    "description": "OTP value for verification."
                  },
                  "customer_token": {
                    "type": "string",
                    "description": "Customer session token. Required for updateCustomerDetails."
                  },
                  "new_email": {
                    "type": "string",
                    "format": "email",
                    "description": "New email to update."
                  },
                  "new_mobile": {
                    "type": "string",
                    "description": "New mobile number to update."
                  },
                  "new_firstname": {
                    "type": "string",
                    "description": "New first name to update."
                  },
                  "new_lastname": {
                    "type": "string",
                    "description": "New last name to update."
                  }
                },
                "required": [
                  "operation"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "customer_id": {
                      "type": "string"
                    },
                    "customer_token": {
                      "type": "string",
                      "description": "Returned after successful registration if login is completed."
                    },
                    "customer": {
                      "type": "object",
                      "description": "Customer profile data."
                    },
                    "otpReferenceId": {
                      "type": "string",
                      "description": "Returned when registration OTP is initiated."
                    },
                    "otpValue": {
                      "type": "string",
                      "description": "Returned only when otp_in_response is enabled."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid parameters."
          },
          "401": {
            "description": "OTP verification failed or invalid customer token."
          },
          "403": {
            "description": "Operation not permitted."
          },
          "404": {
            "description": "Customer not found."
          },
          "409": {
            "description": "Identity conflict, such as email or mobile already in use."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  }
}